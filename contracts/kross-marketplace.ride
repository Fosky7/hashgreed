// contracts/kross-marketplace.ride
{-# STDLIB_VERSION 6 #-}
{-# CONTENT_TYPE DAPP #-}
{-# SCRIPT_TYPE ACCOUNT #-}

func priceKey(assetId: String)   = "listing_" + assetId + "_price"
func sellerKey(assetId: String)  = "listing_" + assetId + "_seller"
func royaltyKey(assetId: String) = "royalty_" + assetId + "_bps"

# Configurable role addresses are stored in state as base58 strings.
func roleAddress(key: String) = {
  let s = match getString(this, key) {
    case v: String => v
    case _ => throw(key + " not set")
  }
  Address(fromBase58String(s))
}

# Helper to validate and normalize address strings (Vulnerability 2 & 4 fix)
func validateAndNormalizeAddress(addrStr: String) = {
  let addr = Address(fromBase58String(addrStr))
  addr.bytes.toBase58String()
}

func requireAdmin(i: Invocation) = {
  if (i.caller != roleAddress("admin")) then throw("Not authorized") else true
}

# Resolve the original creator (issuer) of an NFT. Asset.issuer is already an Address.
func creatorAddress(assetIdStr: String) = {
  match assetInfo(fromBase58String(assetIdStr)) {
    case a: Asset => a.issuer
    case _ => throw("Unknown asset")
  }
}

# Fetch royalty bps for asset; default to 2.5% (250 bps) if not set. Cap at 500 bps.
func getRoyaltyBps(assetId: String) = {
  let bps = match getInteger(this, royaltyKey(assetId)) {
    case v: Int => v
    case _ => 250
  }
  if (bps < 250) then 250 else if (bps > 500) then 500 else bps
}

# One-time init: set admin and feeWallet. Callable only until admin exists.
@Callable(i)
func init(feeWallet: String) = { # Vulnerability 1 fix: removed admin parameter
  if (getString(this, "admin").isDefined()) then throw("Already initialized")
  # Fix: Removed 'else if (i.caller != tx.sender)'. 'tx' is not available in @Callable context.
  # The first caller of init will become the admin.
  else [
    StringEntry("admin", i.caller.bytes.toBase58String()), # Vulnerability 1 fix: set deployer as admin
    StringEntry("feeWallet", validateAndNormalizeAddress(feeWallet)) # Vulnerability 2 & 4 fix: validate feeWallet
  ]
}

# Vulnerability 5 fix: Admin can be rotated
@Callable(i)
func setAdmin(newAdmin: String) = {
  if (requireAdmin(i)) then {
    let validatedAdmin = validateAndNormalizeAddress(newAdmin)
    [ StringEntry("admin", validatedAdmin) ]
  } else []
}

# Admin can rotate the fee wallet later.
@Callable(i)
func setFeeWallet(feeWallet: String) = {
  if (requireAdmin(i)) then [ StringEntry("feeWallet", validateAndNormalizeAddress(feeWallet)) ] else [] # Vulnerability 2 & 4 fix: validate feeWallet
}

# Admin can set the platform fee in basis points.
@Callable(i)
func setFeeBps(bps: Int) = {
  if (requireAdmin(i)) then {
    if (bps < 0) then throw("Fee cannot be negative")
    else if (bps > 1000) then throw("Fee too high") # 10% cap
    else [ IntegerEntry("feeBps", bps) ]
  } else []
}

# Creator sets or updates perpetual royalty between 2.5% and 5% (in basis points).
@Callable(i)
func setRoyalty(assetId: String, bps: Int) = {
  if (bps < 250) then throw("Royalty too low")
  else if (bps > 500) then throw("Royalty too high")
  else {
    let creator = creatorAddress(assetId)
    if (i.caller != creator) then throw("Only creator can set royalty")
    else [ IntegerEntry(royaltyKey(assetId), bps) ]
  }
}

# List NFT into escrow: caller must attach exactly one NFT unit with the specified assetId.
@Callable(i)
func listNFT(assetId: String, price: Int) = {
  let expectedAssetIdBytes = fromBase58String(assetId) # This is a ByteVector
  if (price <= 0) then throw("Price must be positive")
  # FIX: Replaced MAX_INT with the literal maximum safe integer value for price
  # to prevent overflow in fraction calculations (max Int / max BPS = 9223372036854775807 / 500)
  else if (price > 18446744073709551) then throw("Price too high to prevent overflow")
  else if (i.payments.size() != 1) then throw("Attach exactly one NFT to escrow")
  else {
    let p = i.payments[0]
    if (p.assetId == unit) then throw("Payment must be the NFT")
    else if (p.amount != 1) then throw("Exactly 1 NFT must be escrowed")
    else {
      # Explicitly unwrap p.assetId to ByteVector, as it's guaranteed not to be unit here.
      let actualAssetIdBytes = match p.assetId {
        case bv: ByteVector => bv
        case _ => throw("Internal error: assetId should be ByteVector here after unit check")
      }

      if (actualAssetIdBytes != expectedAssetIdBytes) then throw("Escrowed assetId mismatch")
      else {
        # Vulnerability 3 fix: Verify asset is a true NFT
        # Now actualAssetIdBytes is definitely a ByteVector, so assetInfo will return Asset|Unit
        let asset = match assetInfo(actualAssetIdBytes) {
          case a: Asset => a
          case _ => throw("Unknown asset or asset info not available")
        }
        # FIX: Changed 'asset.isReissuable' to 'asset.reissuable'
        if (asset.reissuable) then throw("Asset must be non-reissuable NFT")
        else if (asset.quantity != 1) then throw("Asset must have quantity 1")
        else {
          let callerStr = i.caller.bytes.toBase58String()
          [
            IntegerEntry(priceKey(assetId), price),
            StringEntry(sellerKey(assetId), callerStr)
          ]
        }
      }
    }
  }
}

# Update the price of an already listed NFT.
@Callable(i)
func updateNFTPrice(assetId: String, newPrice: Int) = {
  let sellerStr = match getString(this, sellerKey(assetId)) {
    case s: String => s
    case _ => throw("Listing not found")
  }
  if (i.caller.bytes.toBase58String() != sellerStr) then throw("Only seller can update price")
  else if (newPrice <= 0) then throw("Price must be positive")
  else if (newPrice > 18446744073709551) then throw("Price too high to prevent overflow")
  else {
    [ IntegerEntry(priceKey(assetId), newPrice) ]
  }
}

# Buy NFT atomically: pay native coin, enforce fees, royalties, and no self-buy.
@Callable(i)
func buyNFT(assetId: String) = {
  let price = match getInteger(this, priceKey(assetId)) {
    case p: Int => p
    case _ => throw("Listing not found")
  }
  let sellerStr = match getString(this, sellerKey(assetId)) {
    case s: String => s
    case _ => throw("Listing not found")
  }
  let payment = if (i.payments.size() != 1) then throw("Exactly one payment required") else i.payments[0]
  if (payment.assetId != unit) then throw("Payment must be native coin")
  else if (payment.amount != price) then throw("Incorrect payment amount")
  else {
    let seller = Address(fromBase58String(sellerStr))
    if (i.caller == seller) then throw("Seller cannot buy own NFT")
    else {
      let feeBps = getInteger(this, "feeBps").valueOrElse(500)
      let royaltyBps = getRoyaltyBps(assetId)
      let fee = fraction(price, feeBps, 10000)
      let royalty = fraction(price, royaltyBps, 10000)
      let proceeds = price - fee - royalty
      if (proceeds < 0) then throw("Splits exceed price")
      else {
        let creator = creatorAddress(assetId)
        [
          ScriptTransfer(seller, proceeds, unit),
          ScriptTransfer(roleAddress("feeWallet"), fee, unit),
          ScriptTransfer(creator, royalty, unit),
          ScriptTransfer(i.caller, 1, fromBase58String(assetId)),
          DeleteEntry(priceKey(assetId)),
          DeleteEntry(sellerKey(assetId))
        ]
      }
    }
  }
}

# Cancel listing and return NFT from escrow to seller.
@Callable(i)
func cancelListing(assetId: String) = {
  let sellerStr = match getString(this, sellerKey(assetId)) {
    case s: String => s
    case _ => throw("Listing not found")
  }
  if (i.caller.bytes.toBase58String() != sellerStr) then throw("Only seller can cancel")
  else {
    let seller = Address(fromBase58String(sellerStr))
    [
      ScriptTransfer(seller, 1, fromBase58String(assetId)),
      DeleteEntry(priceKey(assetId)),
      DeleteEntry(sellerKey(assetId))
    ]
  }
}

@Verifier(tx)
func verify() = sigVerify(tx.bodyBytes, tx.proofs[0], tx.senderPublicKey)
